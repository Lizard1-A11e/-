import psutil
import platform
import time
import json
from collections import namedtuple

# Для сбора информации о GPU (если установлена библиотека)
try:
    from gpustat import GPUStatCollection
    GPU_AVAILABLE = True
except ImportError:
    GPU_AVAILABLE = False

def get_system_info():
    """Сбор общей информации о системе"""
    return {
        "system": platform.system(),
        "node": platform.node(),
        "release": platform.release(),
        "version": platform.version(),
        "machine": platform.machine(),
        "processor": platform.processor()
    }

def get_cpu_usage():
    """Текущая загрузка процессора (в процентах)"""
    return psutil.cpu_percent(interval=1)

def get_memory_usage():
    """Использование оперативной памяти"""
    mem = psutil.virtual_memory()
    return {
        "percent": mem.percent,
        "used_gb": round(mem.used / (1024 ** 3), 2),
        "total_gb": round(mem.total / (1024 ** 3), 2)
    }

def get_disk_usage():
    """Использование дискового пространства для всех разделов"""
    disks = []
    for part in psutil.disk_partitions(all=False):
        try:
            usage = psutil.disk_usage(part.mountpoint)
            disks.append({
                "device": part.device,
                "mountpoint": part.mountpoint,
                "fstype": part.fstype,
                "percent": usage.percent,
                "used_gb": round(usage.used / (1024 ** 3), 2),
                "total_gb": round(usage.total / (1024 ** 3), 2)
            })
        except PermissionError:
            continue
    return disks

def get_network_stats():
    """Сетевая активность (байты отправлено/получено)"""
    net = psutil.net_io_counters()
    return {
        "bytes_sent": net.bytes_sent,
        "bytes_recv": net.bytes_recv,
        "packets_sent": net.packets_sent,
        "packets_recv": net.packets_recv
    }

def get_temperatures():
    """Температуры компонентов (зависит от ОС и датчиков)"""
    temps = {}
    if hasattr(psutil, "sensors_temperatures"):
        try:
            data = psutil.sensors_temperatures()
            for name, entries in data.items():
                temps[name] = [{"label": e.label, "current": e.current} for e in entries]
        except Exception:
            pass
    return temps

def get_fan_speeds():
    """Скорости вращения вентиляторов"""
    fans = {}
    if hasattr(psutil, "sensors_fans"):
        try:
            data = psutil.sensors_fans()
            for name, entries in data.items():
                fans[name] = [{"label": e.label, "current": e.current} for e in entries]
        except Exception:
            pass
    return fans

def get_gpu_info():
    """Информация о видеокартах (если доступна)"""
    if not GPU_AVAILABLE:
        return {"error": "Библиотека gpustat не установлена"}
    try:
        stats = GPUStatCollection.new_query()
        gpus = []
        for gpu in stats.gpus:
            gpus.append({
                "name": gpu.entry['name'],
                "temperature": gpu.entry['temperature.gpu'],
                "utilization": gpu.entry['utilization.gpu'],
                "memory_used_mb": gpu.entry['memory.used'],
                "memory_total_mb": gpu.entry['memory.total']
            })
        return gpus
    except Exception as e:
        return {"error": str(e)}

if __name__ == "__main__":
    report = {
        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
        "system_info": get_system_info(),
        "cpu_usage_percent": get_cpu_usage(),
        "memory_usage": get_memory_usage(),
        "disk_usage": get_disk_usage(),
        "network_stats": get_network_stats(),
        "temperatures": get_temperatures(),
        "fan_speeds": get_fan_speeds(),
        "gpu_info": get_gpu_info()
    }

    # Вывод отчета в формате JSON для удобства чтения и парсинга
    print(json.dumps(report, indent=4))"
